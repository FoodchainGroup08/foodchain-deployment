# ── Database (AWS RDS) ───────────────────────────────────────────────────────
RDS_ENDPOINT=my-rds-mysql.xxxx.us-east-1.rds.amazonaws.com
RDS_PORT=3306
RDS_USERNAME=admin
RDS_PASSWORD=your-rds-password

# ── Kafka (Confluent Cloud) ──────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
KAFKA_API_KEY=your-confluent-api-key
KAFKA_API_SECRET=your-confluent-api-secret

# ── Redis (Redis Cloud) ──────────────────────────────────────────────────────
REDIS_HOST=redis-xxxxx.cloud.redislabs.com
REDIS_PORT=12345
REDIS_PASSWORD=your-redis-password

# ── AI Food Suggestions (menu-service) ───────────────────────────────────────
APP_AI_FOOD_SUGGESTIONS_ENABLED=false
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ── Account 1 connection (replace with your Account 1 Elastic IP) ───────────
EUREKA_SERVER_URL=http://YOUR_ACCOUNT1_ELASTIC_IP:8761/eureka/
CONFIG_SERVER_URL=optional:configserver:http://YOUR_ACCOUNT1_ELASTIC_IP:8761
