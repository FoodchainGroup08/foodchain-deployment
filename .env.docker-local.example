# Use these values in `.env` when you run `docker compose up` with the bundled
# MySQL, Redis, and Kafka services (defaults match docker-compose.yml).
#
# If `.env` still points at AWS RDS / Confluent / Redis Cloud, containers will use
# those hosts instead of the local containers.

RDS_ENDPOINT=mysql
RDS_PORT=3306
RDS_USERNAME=root
RDS_PASSWORD=root

# If Docker fails with "bind: address already in use" on 3306, another MySQL is running on the host.
# Map the container to a free port (containers still connect via hostname mysql on port 3306).
MYSQL_HOST_PORT=3307

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_API_KEY=
KAFKA_API_SECRET=

# Optional AI food suggestion agent for menu-service.
# Set both values to use the real LLM path; otherwise menu-service falls back to local ranking.
APP_AI_FOOD_SUGGESTIONS_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional — links in password-reset / welcome emails (default works for local frontend):
# FRONTEND_URL=http://localhost:5173

# user-service is exposed on host port 8086 by default (matches Spring Cloud config).
# USER_SERVICE_HOST_PORT=8086

# Config Server in Docker uses profile `native` + mounted ../foodchain-config (see docker-compose.yml).
# Do not set CONFIG_REPO_URI to a placeholder — invalid URLs make the container unhealthy.

# Keep your existing entries:
# CONFIG_REPO_URI=...   # only if you run Config Server from Git (not the default Compose setup)
# JWT_SECRET=...
# BREVO_API_KEY=...
# BREVO_SENDER_EMAIL=...
